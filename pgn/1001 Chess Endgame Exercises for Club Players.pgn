[White "Exercise 271 - Mate the king"]
[Black "4.6 The Mighty Queen - Defending to Survive"]
[FEN "2q4k/6p1/6K1/3Q1PP1/2p5/8/7P/8 w - - 0 67"]
[Result "*"]

